rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Alapértelmezett védelem: mindent letiltunk
    match /{document=**} {
      allow read, write: if false;
    }

    // A játék és aim sessionök: bárki olvashatja (ranglista miatt), de csak belépve lehet menteni/törölni
    match /game_sessions/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /aim_sessions/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Az új entitások védelme
    match /user_profiles/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /achievements/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /feedback/{document} {
      // Visszajelzést írni is csak bejelentkezve lehet
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
